{
  "name": "plants",
  "label": "What you’ll find here",
  "description": "Brought across from a page made elsewhere; every word, picture and link is a field.",
  "version": 1,
  "fields": {
    "heading": {
      "kind": "text",
      "label": "Heading"
    },
    "cards": {
      "kind": "list",
      "label": "Cards",
      "fields": {
        "heading": {
          "kind": "text",
          "label": "Heading"
        },
        "text": {
          "kind": "text",
          "label": "Text"
        }
      },
      "max": 100,
      "itemLabel": "heading"
    }
  },
  "defaults": {
    "heading": "What you’ll find here",
    "cards": [
      {
        "heading": "Native perennials",
        "text": "Over 200 varieties grown from local seed, chosen to feed bees and survive August."
      },
      {
        "heading": "Hand-thrown pots",
        "text": "Stoneware planters made two doors down by our neighbour Ruth, glazed in river colours."
      },
      {
        "heading": "Saturday workshops",
        "text": "Seed saving, pruning and container gardens — tea and biscuits included, muddy boots welcome."
      }
    ]
  },
  "template": "<section class=\"features i-plants\"> <h2>{{heading}}</h2> <div class=\"grid3\"> {{#each cards}}<div class=\"card\"><h3>{{heading}}</h3><p>{{text}}</p></div>{{/each}} </div> </section>",
  "css": ":scope{--moss:#2e5e4e;--cream:var(--os-color-background);--ink:var(--os-color-text);--sand:#e8ddc8}\n:scope{font-family:var(--os-font-body);color:var(--ink);line-height:1.6}\n:where(h1,h2,h3,h4,h5,h6){color:inherit;font-family:inherit;font-weight:bold;font-style:inherit;letter-spacing:normal;text-transform:none;line-height:inherit;text-wrap:wrap}\n:where(h1){font-size:2em}:where(h2){font-size:1.5em}:where(h3){font-size:1.17em}:where(h4){font-size:1em}:where(h5){font-size:.83em}:where(h6){font-size:.67em}\n:where(.os-ci){display:inline-block;max-width:100%;vertical-align:middle;aspect-ratio:auto}\n.os-ci>picture{display:contents}\n.os-ci img{display:block;width:100%;height:100%;object-fit:inherit;object-position:inherit;border-radius:inherit}\n*{box-sizing:border-box}\n.features{background:var(--moss);color:var(--cream);padding:80px 48px}\n.features h2{font-family:var(--os-font-heading);font-size:40px;margin:0 0 40px;text-align:center}\n.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}\n.card{background:rgba(255,255,255,.08);border-radius:20px;padding:32px}\n.card h3{font-family:var(--os-font-heading);font-size:24px;margin:0 0 8px;color:var(--sand)}\n@media (max-width: 760px){.grid3{grid-template-columns:1fr}}\n@media (max-width: 760px){.features{padding:56px 20px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none"
    }
  }
}
