{
  "name": "story",
  "label": "Started on a back porch",
  "description": "Brought across from a page made elsewhere; every word, picture and link is a field.",
  "version": 1,
  "fields": {
    "photo": {
      "kind": "image",
      "label": "Photo"
    },
    "heading": {
      "kind": "text",
      "label": "Heading"
    },
    "text": {
      "kind": "text",
      "label": "Text",
      "multiline": true
    },
    "cta": {
      "kind": "link",
      "label": "Cta"
    },
    "ctaLabel": {
      "kind": "text",
      "label": "Cta label"
    }
  },
  "defaults": {
    "photo": {
      "src": "media/2026/10/800-q2ff.jpg",
      "alt": "Hands repotting a seedling",
      "width": 800,
      "height": 800,
      "mediaId": "med_q2ffdbja9v"
    },
    "heading": "Started on a back porch",
    "text": "Fern Hollow began in 2014 with forty seedlings and a borrowed greenhouse. Today we’re a family of six growers who still believe the best garden advice is the honest kind: plant less, water deeply, and wait.",
    "cta": {
      "type": "page",
      "page": "pg_z6zqpr8m4w",
      "anchor": "visit"
    },
    "ctaLabel": "Meet the growers"
  },
  "template": "<section class=\"story i-story\"> {{image photo class=\"os-ci\"}} <div> <h2>{{heading}}</h2> <p>{{text}}</p> <a href=\"{{href cta}}\" class=\"btn\">{{ctaLabel}}</a> </div> </section>",
  "css": ":scope{--clay:var(--os-color-accent);--ink:var(--os-color-text)}\n:scope{font-family:var(--os-font-body);color:var(--ink);line-height:1.6}\n:where(h1,h2,h3,h4,h5,h6){color:inherit;font-family:inherit;font-weight:bold;font-style:inherit;letter-spacing:normal;text-transform:none;line-height:inherit;text-wrap:wrap}\n:where(h1){font-size:2em}:where(h2){font-size:1.5em}:where(h3){font-size:1.17em}:where(h4){font-size:1em}:where(h5){font-size:.83em}:where(h6){font-size:.67em}\n:where(.os-ci){display:inline-block;max-width:100%;vertical-align:middle;aspect-ratio:auto}\n.os-ci>picture{display:contents}\n.os-ci img{display:block;width:100%;height:100%;object-fit:inherit;object-position:inherit;border-radius:inherit}\n*{box-sizing:border-box}\n.btn{display:inline-block;background:var(--clay);color:#fff;padding:14px 28px;border-radius:999px;text-decoration:none;font-weight:600}\n.story{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:96px 48px;align-items:center}\n.story [class~=\"os-ci\"]{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50%}\n.story img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50%}\n.story h2{font-family:var(--os-font-heading);font-size:44px;color:var(--clay);margin:0 0 16px}\n@media (max-width: 760px){.story{grid-template-columns:1fr;padding:40px 20px;gap:28px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none"
    }
  }
}
